# ACT (Action Chunking Transformer), ~50M params, trained from scratch. Fits on any GPU
# (2-6 GB at batch 8 per the LeRobot hardware guide); useful as the "small BC baseline" and
# as the fast path to validate infra. Camera keys are taken from the dataset as-is.
# https://huggingface.co/docs/lerobot/v0.6.1/act
POLICY_ARGS_STR="
--policy.type=act
--policy.chunk_size=100
--policy.n_action_steps=100
--policy.device=cuda
--dataset.image_transforms.enable=true
"
BATCH_SIZE=${BATCH_SIZE:-32}
# ACT has no pretrained weights and no LoRA path.
PEFT_SUPPORTED=0
FSDP_WRAP_CLS=${FSDP_WRAP_CLS:-}

# Physical Intelligence pi0.5 via LeRobot 0.6.1 (https://huggingface.co/docs/lerobot/v0.6.1/pi05).
# Requires an HF token with the Gemma licence accepted (google/paligemma-3b-pt-224) ->
# set HF_TOKEN_SECRET_ARN on the job.
# With --policy.type=pi05 + --policy.pretrained_path (the documented recipe) the input
# features are taken from the dataset, so the camera keys are used as-is; do NOT pass a
# --rename_map here (that is for the --policy.path=lerobot/pi05_base flow and makes every
# image feature "missing"). The base model has 3 camera slots, we have 2 -> empty_cameras=1.
# All --policy.* flags below verified against `lerobot-train --policy.type=pi05 --help` (0.6.1).
POLICY_ARGS_STR="
--policy.type=pi05
--policy.pretrained_path=lerobot/pi05_base
--policy.dtype=bfloat16
--policy.gradient_checkpointing=true
--policy.chunk_size=50
--policy.n_action_steps=50
--policy.empty_cameras=1
--policy.device=cuda
--optimizer.lr=2.5e-5
"
BATCH_SIZE=${BATCH_SIZE:-16}
# Only needed when DISTRIBUTED=fsdp. PI05Policy does not declare _fsdp_wrap_modules in 0.6.1.
FSDP_WRAP_CLS=${FSDP_WRAP_CLS:-}
# LoRA (PEFT=1): rank/alpha defaults in train.sh; LR ~10x full fine-tune.
PEFT_LR=${PEFT_LR:-2.5e-4}

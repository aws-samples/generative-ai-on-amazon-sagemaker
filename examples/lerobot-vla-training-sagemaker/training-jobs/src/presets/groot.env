# NVIDIA GR00T N1.7 via LeRobot 0.6.1. Recipe follows the SO-101 example in
# https://huggingface.co/docs/lerobot/v0.6.1/groot (new_embodiment, relative actions).
# Camera keys in the vials dataset are observation.images.external_D455 (front) and
# observation.images.ego (wrist); GR00T takes them as-is, no rename needed.
# All --policy.* flags below verified against `lerobot-train --policy.type=groot --help` (0.6.1).
POLICY_ARGS_STR="
--policy.type=groot
--policy.base_model_path=nvidia/GR00T-N1.7-3B
--policy.embodiment_tag=new_embodiment
--policy.chunk_size=16
--policy.n_action_steps=16
--policy.use_relative_actions=true
--policy.relative_exclude_joints=[\"gripper\"]
--policy.use_bf16=true
--policy.device=cuda
--dataset.image_transforms.enable=true
--use_policy_training_preset=true
"
# NVIDIA trains at global batch 64 (0.6.1 has no gradient accumulation flag). Start at 32
# on a single 96 GB g7e and measure; with N GPUs the effective batch is BATCH_SIZE x N.
BATCH_SIZE=${BATCH_SIZE:-32}
# Only needed when DISTRIBUTED=fsdp: the repeated transformer block class to shard.
# GrootPolicy does not declare _fsdp_wrap_modules in 0.6.1; confirm the class name from the
# model before enabling FSDP (DDP is the default and fits on 80/96 GB GPUs).
FSDP_WRAP_CLS=${FSDP_WRAP_CLS:-}
# Memory notes. Trains projector + diffusion head (backbone frozen); peak ~41 GB at batch 32 on g7e.
# LeRobot 0.6.1 has no LoRA for GR00T. On 24 GB GPUs train the projector only:
#   --extra-args "--policy.tune_diffusion_model=false"
PEFT_SUPPORTED=0
PEFT_UNSUPPORTED_HINT="On 24 GB GPUs use --extra-args '--policy.tune_diffusion_model=false'."

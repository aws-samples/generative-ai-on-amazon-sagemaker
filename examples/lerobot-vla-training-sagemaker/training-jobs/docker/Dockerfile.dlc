# LeRobot VLA training image on the AWS Deep Learning Container (PyTorch training, SageMaker flavour).
#
# What the DLC already provides (2.10.0-...-sagemaker-v2.3):
#   torch 2.10.0+cu130, torchvision 0.25.0+cu130, cuDNN 9.15, Python 3.13, pip,
#   EFA userspace (libfabric 2.4.0) and aws-ofi-nccl installed as BOTH libnccl-net-ofi.so and
#   libnccl-net.so with /opt/amazon/ofi-nccl/lib on LD_LIBRARY_PATH, sagemaker-training toolkit.
# => no EFA installer, no NCCL plugin symlinks, no pip seeding needed here.
#
# DO NOT use the torch 2.9 DLC (2.9.0-gpu-py312-...) for GR00T N1.7: PyTorch 2.9.x has a bf16 Conv3d
# regression (pytorch/pytorch#166122, #168167, #174051) that makes Qwen3-VL's patch embedding fall off
# cuDNN: measured 21 s per Conv3d call vs 0.6 ms (RTX PRO 6000) / 3 ms (L4) on torch 2.10/2.11,
# i.e. ~85 s per GR00T training step. ACT and pi0.5 are unaffected. Fixed in torch 2.10.
#
# What we add: LeRobot + policy extras and the launcher. torch/torchvision are
# pinned through a constraints file so `pip install lerobot[...]` cannot replace the DLC's CUDA 13 wheels.
#
# Video decoding: NO torchcodec here. The DLC's Python is a static build (Py_ENABLE_SHARED=0, no
# shared libpython) and torchcodec's libtorchcodec_custom_ops*.so links against the shared libpython,
# so it can never load ("Could not load libtorchcodec"). LeRobot 0.6.1 falls back to PyAV automatically
# (get_safe_default_video_backend() -> "pyav"); PyAV wheels bundle FFmpeg incl. dav1d, so the AV1
# datasets decode without any apt ffmpeg.
#
# flash-attn: the DLC ships flash-attn 2.8.3 built against CUDA 12 (needs libcudart.so.12), which cannot
# import in this CUDA 13 image. GR00T detects the package, retries the import on every forward and falls
# back to a slow path: measured ~85 s/step vs 0.75 s/step without the package. Uninstall it (or pass
# --policy.use_flash_attention=false).
#
#   docker build -t lerobot-vla:0.6.1-dlc -f docker/Dockerfile.dlc .   (context = training-jobs/)

ARG DLC_ACCOUNT=763104351884
ARG DLC_REGION=us-east-2
ARG DLC_TAG=2.10.0-gpu-py313-cu130-ubuntu22.04-sagemaker-v2.3
FROM ${DLC_ACCOUNT}.dkr.ecr.${DLC_REGION}.amazonaws.com/pytorch-training:${DLC_TAG}

ARG LEROBOT_VERSION=0.6.1
ARG LEROBOT_EXTRAS="groot,pi,peft,training"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/opt/ml/cache/huggingface \
    HF_LEROBOT_HOME=/opt/ml/cache/huggingface/lerobot \
    TORCH_HOME=/opt/ml/cache/torch \
    TRITON_CACHE_DIR=/opt/ml/cache/triton \
    MUJOCO_GL=egl \
    NCCL_NET_PLUGIN=ofi

# jq for resourceconfig.json parsing in train.sh; GL/EGL for any MuJoCo-based eval.
RUN apt-get update && apt-get install -y --no-install-recommends jq libgl1 libegl1 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Freeze the DLC's torch stack so LeRobot's resolver keeps it.
RUN python - <<'PY'
import torch, torchvision, torchaudio
open("/tmp/constraints.txt","w").write(
    f"torch=={torch.__version__}\ntorchvision=={torchvision.__version__}\ntorchaudio=={torchaudio.__version__}\n")
print(open("/tmp/constraints.txt").read())
PY
RUN pip install -c /tmp/constraints.txt \
        --extra-index-url https://download.pytorch.org/whl/cu130 \
        "lerobot[${LEROBOT_EXTRAS}]==${LEROBOT_VERSION}" \
    && pip uninstall -y torchcodec flash-attn flash_attn 2>/dev/null || true \
    && rm -f /tmp/constraints.txt

RUN mkdir -p /opt/ml/cache /opt/ml/checkpoints /opt/ml/model /opt/ml/code
COPY src/ /opt/ml/code/
RUN chmod +x /opt/ml/code/train.sh
WORKDIR /opt/ml/code

# Build-time smoke test: torch untouched, policies import, CLI works, EFA plugin present.
RUN python -c "import torch, torchvision, lerobot, av; print('torch', torch.__version__, 'tv', torchvision.__version__, 'lerobot', lerobot.__version__, 'pyav', av.__version__); assert torch.__version__.startswith('2.10.0+cu130'), torch.__version__" \
    && python -c "from lerobot.datasets.video_utils import get_safe_default_video_backend as g; b=g(); print('video backend', b); assert b=='pyav'" \
    && python -c "import lerobot.policies.groot, lerobot.policies.pi05, lerobot.policies.act" \
    && lerobot-train --help > /dev/null 2>&1 \
    && test -f /opt/amazon/ofi-nccl/lib/libnccl-net.so \
    && /opt/amazon/efa/bin/fi_info --version \
    && command -v pip3 >/dev/null \
    && ! python -c "import flash_attn" 2>/dev/null

CMD ["/bin/bash"]
